{
  "name": "tjupt-files",
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "routes": [
    { "pattern": "files.tju.pt", "custom_domain": true }
  ],
  "vars": {
    "B2_S3_ENDPOINT": "https://s3.us-west-002.backblazeb2.com",
    "B2_REGION": "us-west-002",
    "B2_BUCKET": "TJUPT-Attachments-v2",
    "BASE_URL": "https://tjupt.org",
    "BROWSER_MAX_AGE": "31536000"
  },
  "kv_namespaces": [
    { "binding": "BLOCKED", "id": "PLACEHOLDER_FILL_BEFORE_DEPLOY" }
  ]
}
